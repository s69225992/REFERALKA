// Схема базы реферальной программы.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // пул (Supabase pooler, 6543) — для приложения
  directUrl = env("DIRECT_URL")     // прямое (5432) — для миграций/db push
}

model Driver {
  id             Int       @id @default(autoincrement())
  yandexDriverId String    @unique @map("yandex_driver_id")
  phone          String?
  fullName       String?   @map("full_name")
  referralCode   String    @unique @map("referral_code")
  referredBy     Int?      @map("referred_by")
  status         String    @default("active")
  photoUrl       String?   @map("photo_url")
  joinedAt       DateTime? @map("joined_at")
  ofertaAcceptedAt DateTime? @map("oferta_accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // связи
  referrer          Driver?             @relation("Referrals", fields: [referredBy], references: [id])
  invited           Driver[]            @relation("Referrals")
  asReferrerLinks   Referral[]          @relation("ReferrerLinks")
  asReferredLink    Referral?           @relation("ReferredLink")
  snapshots         CommissionSnapshot[]
  accrualsAsReferrer ReferralAccrual[]  @relation("AccrualReferrer")
  accrualsAsReferred ReferralAccrual[]  @relation("AccrualReferred")
  account           Account?
  dailyStats        DriverDailyStat[]

  @@map("drivers")
}

// Внешний реферер (агент), не Fleet-водитель. Хранится у нас.
model Agent {
  id           Int      @id @default(autoincrement())
  fullName     String?  @map("full_name")
  phone        String?  @unique
  email        String?  @unique
  referralCode String   @unique @map("referral_code")
  photoUrl     String?  @map("photo_url")
  birthDate    DateTime? @map("birth_date") // дата рождения (саморегистрация агента)
  regDevice    String?  @map("reg_device") // устройство при регистрации (ios/android/desktop/web)
  regRegion    String?  @map("reg_region") // регион по гео (страна, город)
  status       String   @default("active") // active | blocked
  createdAt    DateTime @default(now()) @map("created_at")

  account   Account?
  referrals Referral[]        @relation("AgentReferrals")
  accruals  ReferralAccrual[] @relation("AgentAccruals")
  @@map("agents")
}

// Учётка для входа (Telegram / телефон / email). Одна на человека, роль сверху.
model Account {
  id           Int      @id @default(autoincrement())
  telegramId   String?  @unique @map("telegram_id")
  phone        String?  @unique
  pendingPhone String?  @map("pending_phone") // номер, полученный из Telegram до выбора роли/привязки
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         String   @default("agent") // admin | manager | agent | driver
  agentId      Int?     @unique @map("agent_id")
  driverId     Int?     @unique @map("driver_id")
  ofertaAcceptedAt DateTime? @map("oferta_accepted_at") // принятие оферты в мини-аппе
  createdAt    DateTime @default(now()) @map("created_at")

  agent  Agent?  @relation(fields: [agentId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])
  withdrawals Withdrawal[]
  @@map("accounts")
}

// Запрос реферера на вывод средств (подтверждает менеджер/парк).
model Withdrawal {
  id         Int       @id @default(autoincrement())
  accountId  Int       @map("account_id")
  amount     Decimal   @db.Decimal(12, 2)
  status     String    @default("requested") // requested | processing | paid | rejected
  requisites String?
  decidedBy  Int?      @map("decided_by")
  decidedAt  DateTime? @map("decided_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  @@index([accountId])
  @@index([status])
  @@map("withdrawals")
}

// Заявка на привязку «водитель-агент» к своему Fleet-профилю (подтверждает менеджер).
model DriverLinkRequest {
  id              Int       @id @default(autoincrement())
  accountId       Int       @map("account_id")
  claimedDriverId Int       @map("claimed_driver_id")
  parkPhone       String    @map("park_phone")
  telegramPhone   String?   @map("telegram_phone")
  status          String    @default("pending") // pending | approved | rejected
  decidedBy       Int?      @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("driver_link_requests")
}

// Склад посуточной статистики водителя (кэш данных Fleet у нас).
model DriverDailyStat {
  id             Int      @id @default(autoincrement())
  driverId       Int      @map("driver_id")
  date           DateTime @db.Date
  orders         Int      @default(0)
  parkCommission Decimal  @default(0) @map("park_commission") @db.Decimal(12, 2)
  final          Boolean  @default(false)
  pulledAt       DateTime @default(now()) @map("pulled_at")

  driver Driver @relation(fields: [driverId], references: [id])
  @@unique([driverId, date])
  @@index([date])
  @@map("driver_daily_stats")
}

// Настройки программы (правит admin): activation_threshold, accrual_months, min_payout, today_mode ...
model ProgramSetting {
  key   String @id
  value String
  @@map("program_settings")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int?     @map("referrer_id") // водитель-реферер (nullable)
  agentId    Int?     @map("agent_id")    // ИЛИ агент-реферер (ровно одно из двух)
  referredId Int      @unique @map("referred_id")
  tariffCode String   @default("3_1") @map("tariff_code")
  active     Boolean  @default(true)
  qualifyingOrders Int @default(0) @map("qualifying_orders") // прогресс квалификации
  activatedAt DateTime? @map("activated_at")                 // когда достигнут порог (иначе не активен)
  createdAt  DateTime @default(now()) @map("created_at")

  referrer Driver? @relation("ReferrerLinks", fields: [referrerId], references: [id])
  agent    Agent?  @relation("AgentReferrals", fields: [agentId], references: [id])
  referred Driver  @relation("ReferredLink", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([agentId])
  @@map("referrals")
}

// Тариф приглашения: комиссия парка % и вознаграждение агента % (с оборота).
model Tariff {
  id       Int     @id @default(autoincrement())
  code     String  @unique              // напр. "3_1"
  name     String                       // напр. "3 / 1"
  parkRate Decimal @map("park_rate") @db.Decimal(6, 3) // % парка (напр. 3.000)
  refRate  Decimal @map("ref_rate")  @db.Decimal(6, 3) // % агента (напр. 1.000)
  active   Boolean @default(true)
  sort     Int     @default(0)

  @@map("tariffs")
}

model CommissionSnapshot {
  id                   Int      @id @default(autoincrement())
  referredId           Int      @map("referred_id")
  periodFrom           DateTime @map("period_from")
  periodTo             DateTime @map("period_to")
  parkCommissionAmount Decimal  @default(0) @map("park_commission_amount") @db.Decimal(12, 2)
  pulledAt             DateTime @default(now()) @map("pulled_at")

  referred Driver @relation(fields: [referredId], references: [id])

  @@unique([referredId, periodFrom, periodTo])
  @@map("commission_snapshots")
}

model ReferralAccrual {
  id             Int      @id @default(autoincrement())
  referrerId     Int?     @map("referrer_id") // водитель-реферер (nullable)
  agentId        Int?     @map("agent_id")    // ИЛИ агент-реферер
  referredId     Int      @map("referred_id")
  periodFrom     DateTime @map("period_from")
  periodTo       DateTime @map("period_to")
  baseAmount     Decimal  @map("base_amount") @db.Decimal(12, 2)
  rate           Decimal  @db.Decimal(10, 8)
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("pending") // pending | paid | failed
  idempotencyKey String   @unique @map("idempotency_key")
  yandexTxId     String?  @map("yandex_tx_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  referrer Driver? @relation("AccrualReferrer", fields: [referrerId], references: [id])
  agent    Agent?  @relation("AgentAccruals", fields: [agentId], references: [id])
  referred Driver  @relation("AccrualReferred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([agentId])
  @@map("referral_accruals")
}

model PayoutLog {
  id        Int      @id @default(autoincrement())
  accrualId Int?     @map("accrual_id")
  request   String?
  response  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("payout_log")
}
